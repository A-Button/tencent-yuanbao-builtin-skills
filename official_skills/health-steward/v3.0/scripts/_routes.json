      "handler": "scripts/diet/update_meal.py",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "update_meal"
      ],
      "usage": "diet_update {mealId:str, patch:{eaten_at?,eaten_at_source?,meal_type?,title?,items?,photo_url?,is_favorited?}}",
