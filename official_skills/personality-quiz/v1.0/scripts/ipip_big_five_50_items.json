{
  "schema_version": "1.0.0",
  "instrument": {
    "name": "IPIP-50-Big-Five-Factor-Markers",
    "version": "goldberg-1992-ipip-50",
    "source": "https://ipip.ori.org/new_ipip-50-item-scale.htm",
    "scoring_source": "https://ipip.ori.org/newScoringInstructions.htm",
    "recommended_citation": "Goldberg, L. R. (1992). The development of markers for the Big-Five factor structure. Psychological Assessment, 4, 26-42. https://doi.org/10.1037/1040-3590.4.1.26",
    "construct_family": "lexical-big-five-markers",
    "license_status": "public-domain",
    "commercial_use_allowed": true,
    "english_items_status": "verbatim-public-domain",
    "source_snapshot_sha256": "b03153d08fe76576dc4fda164bb3dd60f0769e2f5d582c74af51ac236231b3a1",
    "zh_cn_translation": "project-translation-draft-0.1-unvalidated",
    "chinese_translation_note": "The IPIP website hosts a contributor-provided Traditional Chinese translation, but the IPIP translation clearing-house states that translations are not verified by anyone associated with the IPIP project. The Simplified Chinese wording in this file remains an independent project draft.",
    "ipip_hosted_traditional_chinese_translation": "https://ipip.ori.org/ChineseAB5CFactorMarkers.htm",
    "ipip_translation_clearing_house": "https://ipip.ori.org/newItemTranslations.htm",
    "construct_note": "The source scores Factor IV as Emotional Stability. This implementation reverses that factor for compatibility with the Mini-IPIP Neuroticism orientation. Factor V is Intellect/Imagination."
  },
  "response_scale": {
    "min": 1,
    "max": 5,
    "en": {
      "1": "Very inaccurate",
      "2": "Moderately inaccurate",
      "3": "Neither inaccurate nor accurate",
      "4": "Moderately accurate",
      "5": "Very accurate"
    },
    "zh-CN": {
      "1": "非常不符合",
      "2": "比较不符合",
      "3": "不确定或一般",
      "4": "比较符合",
      "5": "非常符合"
    }
  },
  "scoring": {
    "positive_key_formula": "keyed_value = response",
    "negative_key_formula": "keyed_value = 6 - response",
    "scale_sum_formula": "sum(keyed_value for the ten items assigned to the trait)",
    "scale_mean_formula": "scale_sum / 10",
    "sum_range": [
      10,
      50
    ],
    "mean_range": [
      1,
      5
    ],
    "factor_iv_transform": "neuroticism = reverse-keyed Emotional Stability",
    "norm_reference": null,
    "interpretation_boundary": "Raw sums and means only; do not report percentiles or population labels without a validated target-population norm."
  },
  "items": [
    {"id": 1, "trait": "extraversion", "reverse": false, "source_key": "1+", "en": "Am the life of the party.", "zh_cn_draft": "你常常是聚会中活跃气氛的人。"},
    {"id": 2, "trait": "agreeableness", "reverse": true, "source_key": "2-", "en": "Feel little concern for others.", "zh_cn_draft": "你很少关心别人。"},
    {"id": 3, "trait": "conscientiousness", "reverse": false, "source_key": "3+", "en": "Am always prepared.", "zh_cn_draft": "你总会提前做好准备。"},
    {"id": 4, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Get stressed out easily.", "zh_cn_draft": "你很容易感到压力重重。"},
    {"id": 5, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Have a rich vocabulary.", "zh_cn_draft": "你掌握丰富的词汇。"},
    {"id": 6, "trait": "extraversion", "reverse": true, "source_key": "1-", "en": "Don't talk a lot.", "zh_cn_draft": "你平时话不多。"},
    {"id": 7, "trait": "agreeableness", "reverse": false, "source_key": "2+", "en": "Am interested in people.", "zh_cn_draft": "你对他人感兴趣。"},
    {"id": 8, "trait": "conscientiousness", "reverse": true, "source_key": "3-", "en": "Leave my belongings around.", "zh_cn_draft": "你会把自己的东西随手乱放。"},
    {"id": 9, "trait": "neuroticism", "reverse": true, "source_key": "4+", "en": "Am relaxed most of the time.", "zh_cn_draft": "大多数时候，你很放松。"},
    {"id": 10, "trait": "imagination", "reverse": true, "source_key": "5-", "en": "Have difficulty understanding abstract ideas.", "zh_cn_draft": "你很难理解抽象的想法。"},
    {"id": 11, "trait": "extraversion", "reverse": false, "source_key": "1+", "en": "Feel comfortable around people.", "zh_cn_draft": "和人们相处时，你感到自在。"},
    {"id": 12, "trait": "agreeableness", "reverse": true, "source_key": "2-", "en": "Insult people.", "zh_cn_draft": "你会说出侮辱别人的话。"},
    {"id": 13, "trait": "conscientiousness", "reverse": false, "source_key": "3+", "en": "Pay attention to details.", "zh_cn_draft": "你会留意细节。"},
    {"id": 14, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Worry about things.", "zh_cn_draft": "你常为事情担忧。"},
    {"id": 15, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Have a vivid imagination.", "zh_cn_draft": "你有丰富而生动的想象力。"},
    {"id": 16, "trait": "extraversion", "reverse": true, "source_key": "1-", "en": "Keep in the background.", "zh_cn_draft": "在人群中，你通常待在不显眼的位置。"},
    {"id": 17, "trait": "agreeableness", "reverse": false, "source_key": "2+", "en": "Sympathize with others' feelings.", "zh_cn_draft": "你能体会并同情他人的感受。"},
    {"id": 18, "trait": "conscientiousness", "reverse": true, "source_key": "3-", "en": "Make a mess of things.", "zh_cn_draft": "你常把事情或环境弄得一团乱。"},
    {"id": 19, "trait": "neuroticism", "reverse": true, "source_key": "4+", "en": "Seldom feel blue.", "zh_cn_draft": "你很少感到低落。"},
    {"id": 20, "trait": "imagination", "reverse": true, "source_key": "5-", "en": "Am not interested in abstract ideas.", "zh_cn_draft": "你对抽象的想法不太感兴趣。"},
    {"id": 21, "trait": "extraversion", "reverse": false, "source_key": "1+", "en": "Start conversations.", "zh_cn_draft": "你会主动开启谈话。"},
    {"id": 22, "trait": "agreeableness", "reverse": true, "source_key": "2-", "en": "Am not interested in other people's problems.", "zh_cn_draft": "你对别人的困难不太感兴趣。"},
    {"id": 23, "trait": "conscientiousness", "reverse": false, "source_key": "3+", "en": "Get chores done right away.", "zh_cn_draft": "你会及时把该做的日常事务完成。"},
    {"id": 24, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Am easily disturbed.", "zh_cn_draft": "你很容易受到干扰而心绪不宁。"},
    {"id": 25, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Have excellent ideas.", "zh_cn_draft": "你常有很好的想法。"},
    {"id": 26, "trait": "extraversion", "reverse": true, "source_key": "1-", "en": "Have little to say.", "zh_cn_draft": "你通常没太多话可说。"},
    {"id": 27, "trait": "agreeableness", "reverse": false, "source_key": "2+", "en": "Have a soft heart.", "zh_cn_draft": "你心肠柔软。"},
    {"id": 28, "trait": "conscientiousness", "reverse": true, "source_key": "3-", "en": "Often forget to put things back in their proper place.", "zh_cn_draft": "你常忘记把东西放回原位。"},
    {"id": 29, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Get upset easily.", "zh_cn_draft": "你很容易感到烦乱或不安。"},
    {"id": 30, "trait": "imagination", "reverse": true, "source_key": "5-", "en": "Do not have a good imagination.", "zh_cn_draft": "你的想象力不太丰富。"},
    {"id": 31, "trait": "extraversion", "reverse": false, "source_key": "1+", "en": "Talk to a lot of different people at parties.", "zh_cn_draft": "在聚会上，你会和许多不同的人交谈。"},
    {"id": 32, "trait": "agreeableness", "reverse": true, "source_key": "2-", "en": "Am not really interested in others.", "zh_cn_draft": "你其实不太关心别人。"},
    {"id": 33, "trait": "conscientiousness", "reverse": false, "source_key": "3+", "en": "Like order.", "zh_cn_draft": "你喜欢井然有序。"},
    {"id": 34, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Change my mood a lot.", "zh_cn_draft": "你的情绪经常发生变化。"},
    {"id": 35, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Am quick to understand things.", "zh_cn_draft": "你能很快理解事情。"},
    {"id": 36, "trait": "extraversion", "reverse": true, "source_key": "1-", "en": "Don't like to draw attention to myself.", "zh_cn_draft": "你不喜欢吸引别人对你的注意。"},
    {"id": 37, "trait": "agreeableness", "reverse": false, "source_key": "2+", "en": "Take time out for others.", "zh_cn_draft": "你愿意抽出时间帮助别人。"},
    {"id": 38, "trait": "conscientiousness", "reverse": true, "source_key": "3-", "en": "Shirk my duties.", "zh_cn_draft": "你会逃避自己的职责。"},
    {"id": 39, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Have frequent mood swings.", "zh_cn_draft": "你的情绪经常起伏。"},
    {"id": 40, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Use difficult words.", "zh_cn_draft": "你会使用较难的词语。"},
    {"id": 41, "trait": "extraversion", "reverse": false, "source_key": "1+", "en": "Don't mind being the center of attention.", "zh_cn_draft": "你不介意成为众人关注的中心。"},
    {"id": 42, "trait": "agreeableness", "reverse": false, "source_key": "2+", "en": "Feel others' emotions.", "zh_cn_draft": "你能感受到他人的情绪。"},
    {"id": 43, "trait": "conscientiousness", "reverse": false, "source_key": "3+", "en": "Follow a schedule.", "zh_cn_draft": "你会按照日程安排做事。"},
    {"id": 44, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Get irritated easily.", "zh_cn_draft": "你很容易感到恼火。"},
    {"id": 45, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Spend time reflecting on things.", "zh_cn_draft": "你会花时间深入思考事情。"},
    {"id": 46, "trait": "extraversion", "reverse": true, "source_key": "1-", "en": "Am quiet around strangers.", "zh_cn_draft": "在陌生人身边时，你很安静。"},
    {"id": 47, "trait": "agreeableness", "reverse": false, "source_key": "2+", "en": "Make people feel at ease.", "zh_cn_draft": "你能让别人感到自在。"},
    {"id": 48, "trait": "conscientiousness", "reverse": false, "source_key": "3+", "en": "Am exacting in my work.", "zh_cn_draft": "你对自己的工作要求严格。"},
    {"id": 49, "trait": "neuroticism", "reverse": false, "source_key": "4-", "en": "Often feel blue.", "zh_cn_draft": "你经常感到低落。"},
    {"id": 50, "trait": "imagination", "reverse": false, "source_key": "5+", "en": "Am full of ideas.", "zh_cn_draft": "你脑中充满各种想法。"}
  ]
}
