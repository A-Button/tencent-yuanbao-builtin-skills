      "handler": "scripts/diet/delete_meal.py",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "delete_meal"
      ],
      "usage": "diet_delete {mealId:str}",
      "summary": "软删一条记录。"
