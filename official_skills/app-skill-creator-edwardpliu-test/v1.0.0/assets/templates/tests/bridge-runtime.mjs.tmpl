// 在 jsdom 里跑构建产物，验证 bridge 的运行时契约而不是字符串包含关系：
// 握手 → Host 推 tool-result → 页面渲染 → 页面发起 tools/call → 结果回灌。
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { JSDOM, VirtualConsole } from "jsdom";

const html = await readFile(resolve("assets/ui/{{UI_OUTPUT}}"), "utf8");

const appMessages = [];
const errors = [];
let hostWindow;
let appWindow;

function deliver(data) {
  appWindow.dispatchEvent(new appWindow.MessageEvent("message", { data, source: hostWindow }));
}

function handleAppMessage(message) {
  appMessages.push(message);
  if (message?.method === "ui/initialize") {
    queueMicrotask(() => deliver({
      jsonrpc: "2.0",
      id: message.id,
      result: {
        protocolVersion: "2026-01-26",
        hostInfo: { name: "test-host", version: "1.0.0" },
        hostCapabilities: {},
        hostContext: {
          theme: "light",
          displayMode: "inline",
          availableDisplayModes: ["inline"],
          locale: "zh-CN",
          safeAreaInsets: { top: 0, right: 0, bottom: 0, left: 0 },
        },
      },
    }));
  }
}

function respondToolCall(message, structuredContent) {
  deliver({
    jsonrpc: "2.0",
    id: message.id,
    result: { content: [], structuredContent },
  });
}

async function waitFor(predicate, message) {
  const deadline = Date.now() + 2000;
  while (Date.now() < deadline) {
    if (predicate()) return;
    await new Promise((done) => setTimeout(done, 10));
  }
  throw new Error(message);
}

const virtualConsole = new VirtualConsole();
virtualConsole.on("jsdomError", (error) => errors.push(error.message));
virtualConsole.on("error", (error) => errors.push(String(error)));

const dom = new JSDOM(html, {
  runScripts: "dangerously",
  url: "https://app.local/assets/ui/{{UI_OUTPUT}}",
  pretendToBeVisual: true,
  virtualConsole,
  beforeParse(window) {
    appWindow = window;
    hostWindow = { postMessage: handleAppMessage };
    Object.defineProperty(window, "parent", { value: hostWindow, configurable: true });
    window.confirm = () => true;
    // SDK 会在 rAF 回调里上报 iframe 尺寸。jsdom 的 rAF 会在 connect() 完成前就跑，
    // 那时 transport 还没就绪，notification 抛 Not connected 并直接崩掉进程。
    // 尺寸上报不在本用例的验证范围，这里让它不发生。
    window.ResizeObserver = class { observe() {} unobserve() {} disconnect() {} };
    window.requestAnimationFrame = () => 0;
    window.cancelAnimationFrame = () => {};
  },
});

try {
  await waitFor(
    () => appMessages.some((m) => m?.method === "ui/notifications/initialized"),
    "UI 未完成握手",
  );

  // 首屏应当自己拉一次列表。
  const firstCall = await waitForCall("list_{{ENTITY_PLURAL}}");
  respondToolCall(firstCall, {
    {{ENTITY_PLURAL}}: [{ id: "a1", title: "已有记录", notes: "备注" }],
    count: 1,
  });
  await waitFor(
    () => appWindow.document.querySelector(".title")?.textContent === "已有记录",
    "首屏列表未渲染",
  );

  // 部分 host context 更新必须合并进已有 context，而不是整体覆盖。
  deliver({
    jsonrpc: "2.0",
    method: "ui/notifications/host-context-changed",
    params: { theme: "dark", safeAreaInsets: { top: 0, right: 0, bottom: 17, left: 0 } },
  });
  await waitFor(
    () => appWindow.document.documentElement.dataset.theme === "dark",
    "主题未应用",
  );
  assert.equal(appWindow.document.body.style.getPropertyValue("--safe-bottom"), "17px");

  // Agent 侧推来的 tool-result 走同一条渲染路径。
  deliver({
    jsonrpc: "2.0",
    method: "ui/notifications/tool-result",
    params: {
      content: [],
      structuredContent: {
        {{ENTITY_PLURAL}}: [
          { id: "a1", title: "已有记录", notes: "备注" },
          { id: "a2", title: "Agent 新建", notes: "" },
        ],
        count: 2,
      },
    },
  });
  await waitFor(
    () => appWindow.document.querySelectorAll(".title").length === 2,
    "Agent 推送的结果未渲染",
  );

  // 页面自己发起写操作。
  const input = appWindow.document.getElementById("title");
  input.value = "页面新建";
  appWindow.document.getElementById("composer").dispatchEvent(
    new appWindow.Event("submit", { bubbles: true, cancelable: true }),
  );
  const createCall = await waitForCall("create_{{ENTITY}}");
  assert.equal(createCall.params.arguments.title, "页面新建");
  // 动作靠 tool 名区分，入参里不该再夹一个 operation。
  assert.equal(createCall.params.arguments.operation, undefined);
  respondToolCall(createCall, {
    {{ENTITY_PLURAL}}: [
      { id: "a1", title: "已有记录", notes: "备注" },
      { id: "a2", title: "Agent 新建", notes: "" },
      { id: "a3", title: "页面新建", notes: "" },
    ],
    count: 3,
  });
  await waitFor(
    () => appWindow.document.querySelectorAll(".title").length === 3,
    "页面自发调用的结果未渲染",
  );

  // 转义验证：标题里的标签不能变成真实节点。
  deliver({
    jsonrpc: "2.0",
    method: "ui/notifications/tool-result",
    params: {
      content: [],
      structuredContent: {
        {{ENTITY_PLURAL}}: [{ id: "x", title: "<img src=x onerror=1>", notes: "" }],
        count: 1,
      },
    },
  });
  await waitFor(
    () => appWindow.document.querySelectorAll(".title").length === 1,
    "转义用例未渲染",
  );
  assert.equal(appWindow.document.querySelectorAll("#stage img").length, 0);

  assert.deepEqual(errors, []);
  console.log("bridge runtime: 握手、host context、双向工具调用与转义均通过");
} finally {
  dom.window.close();
}

async function waitForCall(tool) {
  let found;
  await waitFor(() => {
    found = appMessages.find(
      (m) => m?.method === "tools/call" && m.params?.name === tool,
    );
    return Boolean(found);
  }, `页面未发起 ${tool} 调用`);
  return found;
}
