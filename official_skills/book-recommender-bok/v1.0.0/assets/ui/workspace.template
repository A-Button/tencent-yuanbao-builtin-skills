<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>图书推荐</title>
<style>
  :root {
    --bg: var(--mcp-color-background, #ffffff);
    --fg: var(--mcp-color-text, #1f2329);
    --muted: #8a9099;
    --line: #e6e8eb;
    --accent: var(--mcp-color-accent, #3370ff);
    --card-bg: #f7f8fa;
    --star: #f5a623;
  }
  [data-theme="dark"] {
    --bg: var(--mcp-color-background, #1a1c1f);
    --fg: var(--mcp-color-text, #e8eaed);
    --muted: #9aa0a6;
    --line: #2f3236;
    --card-bg: #24272b;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    padding: 16px;
    padding-bottom: calc(16px + var(--safe-bottom, 0px));
    font: 14px/1.6 -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
    color: var(--fg);
    background: var(--bg);
  }

  .search-bar {
    display: flex; gap: 10px; margin-bottom: 12px;
  }
  .search-bar input {
    flex: 1; min-width: 0; padding: 10px 14px; font: inherit; color: var(--fg);
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    outline: none; transition: border-color .2s;
  }
  .search-bar input:focus { border-color: var(--accent); }
  .search-bar button {
    padding: 10px 18px; font: inherit; font-weight: 500; color: #fff;
    background: var(--accent); border: none; border-radius: 10px; cursor: pointer;
    white-space: nowrap; transition: opacity .2s;
  }
  .search-bar button:disabled { opacity: .5; cursor: default; }

  .quick-row { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; align-items: center; }
  .chip {
    padding: 5px 12px; font-size: 12px; border-radius: 20px; border: 1px solid var(--line);
    background: var(--bg); color: var(--fg); cursor: pointer; user-select: none;
    transition: all .15s;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  .book-grid {
    display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .book-card {
    padding: 14px; background: var(--card-bg); border-radius: 12px;
    border: 1px solid var(--line);
  }
  .book-card .title { font-size: 15px; font-weight: 600; line-height: 1.4; }
  .book-card .author { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .book-card .meta { display: flex; align-items: center; gap: 10px; margin-top: 6px; font-size: 12px; }
  .book-card .rating { color: var(--star); font-weight: 600; }
  .book-card .category {
    padding: 2px 8px; font-size: 11px; border-radius: 10px;
    background: var(--line); color: var(--muted);
  }
  .book-card .desc { margin-top: 8px; font-size: 12px; color: var(--muted); line-height: 1.6; }

  .empty, .error, .loading { padding: 32px 0; text-align: center; color: var(--muted); }
  .error { color: #d54941; }
  [data-touch="true"] .chip { padding: 8px 16px; }
</style>
</head>
<body>
  <div class="search-bar">
    <input type="text" id="query" placeholder="搜索书名或作者…" autocomplete="off">
    <button id="search-btn">搜索</button>
    <button id="recommend-btn" style="background:transparent;color:var(--accent);border:1px solid var(--accent);">推荐</button>
  </div>

  <div class="quick-row" id="categories"></div>

  <div id="stage"><div class="loading">加载中…</div></div>

  <!-- MCP_BRIDGE_START -->
  <script>/*__MCP_BRIDGE__*/</script>
  <!-- MCP_BRIDGE_END -->

  <script>
  (function () {
    var bridge = window.bookRecommenderMcp;
    var stage = document.getElementById("stage");
    var queryInput = document.getElementById("query");
    var searchBtn = document.getElementById("search-btn");
    var recommendBtn = document.getElementById("recommend-btn");
    var categoriesEl = document.getElementById("categories");
    var books = [];
    var categories = [];
    var busy = false;
    var activeCategory = "";

    function el(tag, className, text) {
      var n = document.createElement(tag);
      if (className) n.className = className;
      if (text != null) n.textContent = text;
      return n;
    }

    function applyHostContext(context) {
      var ctx = context || {};
      document.documentElement.dataset.theme = ctx.theme === "dark" ? "dark" : "light";
      var caps = ctx.deviceCapabilities || {};
      document.body.dataset.touch = caps.touch ? "true" : "false";
      var insets = ctx.safeAreaInsets || {};
      document.body.style.setProperty("--safe-bottom", (insets.bottom || 0) + "px");
    }

    function normalize(payload) {
      if (!payload) return null;
      return payload.structuredContent || payload;
    }

    function starStr(rating) {
      var n = Math.round(rating || 0);
      var s = ""; for (var i = 0; i < n; i++) s += "★"; return s;
    }

    function renderBooks() {
      stage.textContent = "";
      if (!books.length) {
        stage.appendChild(el("div", "empty", "没有找到匹配的图书，试试换个关键词吧"));
        return;
      }
      var grid = el("div", "book-grid");
      books.forEach(function (b) {
        var card = el("div", "book-card");
        card.appendChild(el("div", "title", b.title));
        card.appendChild(el("div", "author", b.author));
        var meta = el("div", "meta");
        meta.appendChild(el("span", "rating", starStr(b.rating) + " " + b.rating));
        meta.appendChild(el("span", "category", b.category));
        card.appendChild(meta);
        card.appendChild(el("div", "desc", b.description));
        grid.appendChild(card);
      });
      stage.appendChild(grid);
    }

    function renderCategories() {
      categoriesEl.textContent = "";
      var all = el("span", "chip" + (activeCategory === "" ? " active" : ""), "全部");
      all.addEventListener("click", function () {
        activeCategory = "";
        renderCategories();
        call("recommend_books", { count: 10 });
      });
      categoriesEl.appendChild(all);

      categories.forEach(function (cat) {
        var chip = el("span", "chip" + (activeCategory === cat ? " active" : ""), cat);
        chip.addEventListener("click", function () {
          activeCategory = cat;
          renderCategories();
          call("recommend_books", { category: cat, count: 10 });
        });
        categoriesEl.appendChild(chip);
      });
    }

    function showError(message) {
      stage.textContent = "";
      stage.appendChild(el("div", "error", message));
    }

    function apply(payload) {
      var data = normalize(payload);
      if (!data) return;
      if (data.phase === "error") {
        if (!books.length) showError(data.message || "操作失败");
        return;
      }
      if (Array.isArray(data.books)) {
        books = data.books;
        renderBooks();
      }
      if (Array.isArray(data.categories) && data.categories.length) {
        categories = data.categories;
        renderCategories();
      }
    }

    function call(toolName, args) {
      if (busy || bridge.isPreview) return Promise.resolve();
      busy = true;
      searchBtn.disabled = true;
      recommendBtn.disabled = true;
      return bridge.callTool(toolName, args || {})
        .then(apply)
        .catch(function (error) {
          if (!books.length) showError(error && error.message ? error.message : "调用失败");
        })
        .finally(function () {
          busy = false;
          searchBtn.disabled = false;
          recommendBtn.disabled = false;
        });
    }

    function doSearch() {
      var q = queryInput.value.trim();
      if (!q) return;
      call("search_books", { query: q });
    }

    searchBtn.addEventListener("click", doSearch);
    queryInput.addEventListener("keydown", function (e) { if (e.key === "Enter") doSearch(); });
    recommendBtn.addEventListener("click", function () {
      activeCategory = "";
      renderCategories();
      call("recommend_books", { count: 10 });
    });

    bridge.onHostContextChanged(applyHostContext);
    bridge.onToolResult(apply);

    bridge.ready.then(function () {
      applyHostContext(bridge.getHostContext());
      if (bridge.isPreview) {
        books = [
          { title: "三体", author: "刘慈欣", rating: 4.8, category: "科幻", description: "预览数据——地球文明与三体文明的首次接触。" },
          { title: "活着", author: "余华", rating: 4.7, category: "文学", description: "预览数据——讲述一个人一生的故事。" }
        ];
        renderBooks();
        return;
      }
      call("list_books", {});
    });
  })();
  </script>
</body>
</html>