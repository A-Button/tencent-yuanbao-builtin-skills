{
  "app": {
    "id": "health-steward",
    "name": "健康管家",
    "version": "v1.0"
  },
  "resources": {
    "ai_apps.skills.diet_assistant_res": {
      "uri": "ai_apps.skills.diet_assistant_res",
      "name": "今日饮食记录",
      "mimeType": "application/a2ui+json",
      "dataMode": "keep_latest"
    }
  },
  "tools": {
    "diet_record": {
      "handler": "scripts/diet/record_meal.py",
      "resourceUri": "ai_apps.skills.diet_assistant_res",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "record_meal"
      ],
      "usage": "diet_record {items:[{name,portion,kcal,protein_g,fat_g,carb_g,sodium_mg}], photoUrl?:str, eatenAt?:str, eatenAtSource?:photo|upload|user, mealType?:breakfast|beverage|lunch|afternoon_tea|dinner|midnight, beverageOnly?:bool}",
      "summary": "落库一餐并出饮食卡。"
    },
    "diet_estimate": {
      "handler": "scripts/diet/estimate_meal.py",
      "resourceUri": "ai_apps.skills.diet_assistant_res",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "estimate_meal"
      ],
      "usage": "diet_estimate {items:[{name,portion,kcal,protein_g,fat_g,carb_g,sodium_mg}], photoUrl?:str}",
      "summary": "只算营养、不落库，卡片照出。"
    },
    "diet_day": {
      "handler": "scripts/diet/get_day.py",
      "resourceUri": "ai_apps.skills.diet_assistant_res",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "get_day"
      ],
      "usage": "diet_day {date?:str}",
      "summary": "看某一天吃了什么：每餐的时间、食物、热量与宏量，以及跳过的餐次。"
    },
    "diet_skip": {
      "handler": "scripts/diet/skip_meal.py",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "skip_meal"
      ],
      "usage": "diet_skip {mealType:breakfast|lunch|dinner, date?:str}",
      "summary": "把早/午/晚某一餐标成跳过，不进热量合计。"
    },
    "diet_stats": {
      "handler": "scripts/diet/get_stats.py",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "diet",
      "aliases": [
        "get_stats"
      ],
      "usage": "diet_stats {period?:day|week, date?:str}",
      "summary": "近 1 天或 7 天的饮食统计：日均热量与宏量、规律性评分。"
    },
