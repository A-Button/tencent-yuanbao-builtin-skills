{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chart request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "bazi",
        "western",
        "combined"
      ]
    },
    "birth_date": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "birth_city": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "birth_time": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "calendar": {
      "enum": [
        "gregorian",
        "lunar"
      ]
    },
    "lunar_is_leap_month": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "time_prompted": {
      "type": "boolean"
    },
    "gender_for_bazi": {
      "enum": [
        "male",
        "female",
        null
      ]
    },
    "include_luck_cycles": {
      "type": "boolean"
    },
    "omit_luck_cycle": {
      "type": "boolean"
    },
    "artifact": {
      "enum": [
        "chart",
        "conclusion",
        "analysis",
        "report"
      ]
    },
    "question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "topics": {
      "type": "array",
      "items": {
        "enum": [
          "career",
          "emotion",
          "family",
          "economy",
          "social",
          "talent",
          "spiritual",
          "study",
          "health"
        ]
      }
    },
    "offer_report": {
      "type": "boolean"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string"
        },
        "fold": {
          "enum": [
            0,
            1
          ]
        },
        "historical_utc_offset": {
          "type": "string",
          "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "source",
            "precision"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "precision": {
              "enum": [
                "city"
              ]
            },
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
