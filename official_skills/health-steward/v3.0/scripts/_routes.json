      "handler": "scripts/training/complete_exercise.py",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "workout",
      "aliases": [
        "complete_exercise"
      ],
      "usage": "workout_done {names?:[str], positions?:[int], date?:str}",
      "summary": "把动作标成已完成，一次可以多个。"
    },
