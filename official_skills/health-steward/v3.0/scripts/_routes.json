      "handler": "scripts/training/complete_session.py",
      "visibility": [
        "model",
        "app"
      ],
      "runtime": "workout",
      "aliases": [
        "complete_session"
      ],
      "hidden": true,
      "usage": "workout_finish {date?:str}",
