      "handler": "scripts/diet/get_nutrition_summary.py",
      "visibility": [
        "model"
      ],
      "runtime": "workout",
      "aliases": [
        "get_nutrition_summary"
      ],
      "usage": "nutrition_summary {date?:str, kcal?:num, carb_g?:num, protein_g?:num, fat_g?:num, fiber_g?:num}",
