<!doctype html>
<html lang="zh-CN" data-theme="light" data-display-mode="inline" data-touch="false">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title>海尔家电推荐</title>
  <style>
    :root{--page:var(--color-background-secondary,#f2f6fb);--card:var(--color-background-primary,#fff);--soft:var(--color-background-tertiary,#f6f8fb);--text:var(--color-text-primary,#142033);--muted:var(--color-text-secondary,#657287);--line:var(--color-border-secondary,#dfe6ef);--brand:#087ac1;--brand-strong:#005aaa;--brand-soft:#e9f5fc;--danger:#b42318;--safe-top:0px;--safe-right:0px;--safe-bottom:0px;--safe-left:0px;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;color:var(--text);background:var(--page)}
    :root[data-theme="dark"]{--page:var(--color-background-secondary,#08131f);--card:var(--color-background-primary,#0f1e2d);--soft:var(--color-background-tertiary,#15283a);--text:var(--color-text-primary,#eef7ff);--muted:var(--color-text-secondary,#a1b3c5);--line:var(--color-border-secondary,#29445c);--brand:#68c5ff;--brand-strong:#8bd3ff;--brand-soft:#113650;--danger:#ffb4ab}
    *{box-sizing:border-box}html,body{min-width:0;margin:0}body{padding:max(20px,var(--safe-top)) max(20px,var(--safe-right)) max(20px,var(--safe-bottom)) max(20px,var(--safe-left));background:var(--page)}
    .shell{width:min(100%,1080px);margin:auto}
    .notice{display:none;margin:0 0 14px;padding:11px 13px;border:1px solid color-mix(in srgb,var(--danger) 30%,var(--line));border-radius:13px;background:color-mix(in srgb,var(--danger) 7%,var(--card));color:var(--danger);font-size:12px}.notice.visible{display:block}.loading,.empty{padding:48px 20px;border:1px dashed var(--line);border-radius:22px;background:color-mix(in srgb,var(--card) 75%,transparent);color:var(--muted);text-align:center}
    .grid{display:flex;gap:14px;min-width:0;margin:0 -3px;padding:3px 3px 14px;overflow-x:auto;overflow-y:hidden;overscroll-behavior-inline:contain;scroll-padding-inline:3px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--brand) 35%,var(--line)) transparent;-webkit-overflow-scrolling:touch}.grid:focus-visible{outline:3px solid color-mix(in srgb,var(--brand) 25%,transparent);outline-offset:4px}.grid::-webkit-scrollbar{height:6px}.grid::-webkit-scrollbar-track{background:transparent}.grid::-webkit-scrollbar-thumb{border-radius:999px;background:color-mix(in srgb,var(--brand) 32%,var(--line))}.product{display:flex;min-width:0;flex:0 0 252px;flex-direction:column;overflow:hidden;border:1px solid color-mix(in srgb,var(--line) 72%,transparent);border-radius:18px;background:var(--card);box-shadow:0 8px 24px rgba(0,0,0,.05);scroll-snap-align:start;scroll-snap-stop:always;transition:box-shadow .25s ease,transform .25s ease}.product:hover{box-shadow:0 12px 32px rgba(0,0,0,.08);transform:translateY(-2px)}.visual{position:relative;height:180px;display:grid;place-items:center;flex:none;overflow:hidden;background:var(--card)}.visual.has-image{background:color-mix(in srgb,var(--brand-soft) 34%,var(--card))}.visual img{display:block;width:100%;height:100%;object-fit:contain;object-position:50% 50%;padding:14px;filter:drop-shadow(0 7px 9px rgba(13,58,91,.12));transition:transform .3s ease}.product:hover .visual img{transform:scale(1.035)}.fallback{color:var(--brand-strong);font-size:24px;font-weight:850;letter-spacing:-.04em}
    .body{display:flex;min-height:180px;flex:1;flex-direction:column;padding:16px}.product-title{display:-webkit-box;min-height:2.55em;margin:0;color:var(--text);font-size:16px;font-weight:780;line-height:1.28;letter-spacing:-.02em;overflow:hidden;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:2}.model{margin:5px 0 0;color:var(--muted);font-size:10px;font-weight:650;line-height:1.4;overflow-wrap:anywhere}.attrs{display:flex;align-content:flex-start;flex-wrap:wrap;gap:5px;margin:10px 0 14px}.attr{max-width:100%;padding:4px 7px;border-radius:8px;background:var(--soft);color:var(--muted);font-size:10px;line-height:1.35;overflow-wrap:anywhere}.desc{margin:10px 0 14px;color:var(--muted);font-size:11px;line-height:1.5}.footer{display:flex;align-items:flex-end;gap:10px;margin-top:auto}
.source{margin:0 0 1px auto;color:var(--muted);font-size:10px;font-weight:650;line-height:14px;text-align:right;white-space:nowrap;padding-left:18px;background:url(haier-icon.png) no-repeat left center/14px 14px;border-radius:3px}
.price{min-width:0;margin:0;color:var(--brand-strong);font-size:20px;font-weight:800;line-height:1}.price:not(.muted):before{content:"¥";margin-right:2px;font-size:12px;font-weight:700}.price.muted{max-width:150px;color:var(--muted);font-size:11px;font-weight:650;line-height:1.35}
    :root[data-display-mode="inline"] .shell{max-width:760px}:root[data-display-mode="fullscreen"] body{padding-top:max(28px,var(--safe-top))}:root[data-display-mode="fullscreen"] .product{flex-basis:280px}:root[data-display-mode="fullscreen"] .visual{height:210px}:root[data-display-mode="fullscreen"] .body{min-height:190px}
    @media(max-width:520px){body{padding-left:max(10px,var(--safe-left));padding-right:max(10px,var(--safe-right))}.product{flex-basis:min(252px,calc(100% - 24px));border-radius:18px}:root[data-display-mode="fullscreen"] .product{flex-basis:min(280px,calc(100% - 24px))}.visual,:root[data-display-mode="fullscreen"] .visual{height:180px}}
  </style>
</head>
<body>
  <main class="shell" aria-live="polite">
    <p id="notice" class="notice" role="alert"></p><section id="content"><div class="loading">推荐结果加载中…</div></section>
  </main>
  <script>/*__MCP_BRIDGE__*/</script>
  <script>
  (()=>{
    const state={data:null,error:""};const content=document.querySelector("#content"),notice=document.querySelector("#notice");
    const el=(tag,className,text)=>{const node=document.createElement(tag);if(className)node.className=className;if(text!==undefined)node.textContent=String(text);return node};
    const safeUrl=(value)=>{try{const url=new URL(String(value||""));return ["http:","https:"].includes(url.protocol)?url.href:""}catch{return ""}};
    function applyContext(context){const root=document.documentElement;const mode=["inline","fullscreen","pip"].includes(context.displayMode)?context.displayMode:"inline";root.dataset.theme=context.theme==="dark"?"dark":"light";root.dataset.displayMode=mode;root.dataset.touch=String(Boolean(context.deviceCapabilities?.touch));const inset=context.safeAreaInsets||{};for(const side of ["top","right","bottom","left"])root.style.setProperty(`--safe-${side}`,`${Number(inset[side])||0}px`)}
    function formatPrice(value){if(value===null||value===undefined||value==="")return "价格以实际页面为准";if(typeof value==="number")return new Intl.NumberFormat(undefined,{maximumFractionDigits:0}).format(value);return String(value).replace(/^[¥￥]\s*/,"")}
    function text(value){return typeof value==="string"?value.trim():""}
    function attributeValue(product,name){return text((product.attributes||[]).find(attribute=>attribute?.name===name)?.value)}
    function displayTitle(product){const model=text(product.name);if(model)return model;const brand=text(product.brand)||"海尔",kind=text(product.prodCate);return kind?`${brand} · ${kind}`:brand}
    function displaySeries(product){const brand=text(product.brand)||"海尔",kind=text(product.prodCate),suite=text(product.spectrum)||attributeValue(product,"套系"),parts=[brand];if(kind)parts.push(kind);if(suite)parts.push(suite.endsWith("系列")?suite:`${suite}系列`);return parts.join(" · ")}
    const ATTR_PRIORITY=["价格","功能偏好","能效等级","容量偏好","洗涤容量","升数偏好","匹数偏好","风量偏好","洗净比","脱水转速","制冷方式","定频/变频","门型偏好","款式类型","安装方式","安装条件","安装限制","安装尺寸","尺寸","尺寸偏好","气源类型","火力大小","灶眼数量","筒数","噪音","脱水噪音","洗涤噪音","颜色","套系"];
    function attrRank(name){const index=ATTR_PRIORITY.indexOf(text(name));return index<0?ATTR_PRIORITY.length:index}
    function orderedAttributes(product,userSlotNames){const attrs=(product.attributes||[]).filter(attr=>text(attr?.name)&&text(attr?.value));const picked=[],seen=new Set();for(const slotName of userSlotNames){if(seen.has(slotName))continue;const hit=attrs.find(attr=>text(attr.name)===slotName);if(hit){picked.push(hit);seen.add(slotName)}}const rest=[];for(const attr of attrs){const name=text(attr.name);if(seen.has(name))continue;seen.add(name);rest.push(attr)}rest.sort((left,right)=>attrRank(left.name)-attrRank(right.name));return[...picked,...rest]}
    function parseContent(result){let value=result?.structuredContent;if(value===undefined&&result?.result?.structuredContent!==undefined)value=result.result.structuredContent;if(value===undefined){const block=(result?.content||[]).find(item=>item?.type==="text"&&text(item.text));if(block){try{value=JSON.parse(block.text)}catch{value={message:block.text}}}}if(value?.success===true&&value.data!==undefined)value=value.data;return value===undefined?result||{}:value}
    function normalizeResult(result){const payload=parseContent(result);if(payload?.phase)return payload;const data=payload?.data&&typeof payload.data==="object"&&!Array.isArray(payload.data)?payload.data:payload;const args=result?._meta?.arguments||result?._meta?.input||payload?.arguments||{};if(result?.isError||data?.ok===false)return{phase:"error",view:"recommend",message:text(data?.message)||"结果暂时无法展示。"};const rawProducts=Array.isArray(data?.recommendations)?data.recommendations:[];const products=rawProducts.slice(0,5).flatMap((raw,index)=>{if(!raw||typeof raw!=="object"||!text(raw.productName))return[];const attributes=(Array.isArray(raw.attributes)?raw.attributes:[]).flatMap(item=>{const name=text(item?.attributeName),value=text(item?.attributeValue);return name&&value?[{name,value}]:[]});return[{rank:Number.isInteger(raw.rank)?raw.rank:index+1,brand:text(raw.brand),prodCate:text(raw.prodCate),spectrum:text(raw.spectrum),name:text(raw.productName),price:["string","number"].includes(typeof raw.price)?raw.price:null,imageUrl:safeUrl(raw.imageUrl||raw.image||raw.productImage),productUrl:safeUrl(raw.productUrl),attributes,highlights:(Array.isArray(raw.highlights)?raw.highlights:[]).map(text).filter(Boolean),reasons:(Array.isArray(raw.recommendReasons)?raw.recommendReasons:[]).map(text).filter(reason=>reason&&reason!=="符合您所选品类及槽位条件")}]});const userSlots=(Array.isArray(args?.request?.categorySlots)?args.request.categorySlots:[]).map(slot=>text(slot?.slotName)).filter(Boolean);return{phase:products.length?"ready":"empty",view:"recommend",userSlots,total:Number.isInteger(data?.total)?data.total:products.length,products,message:products.length?"":text(data?.message)||"暂未查询到相关产品。"}}
    function render(){notice.textContent=state.error;notice.classList.toggle("visible",Boolean(state.error));if(!state.data)return;const data=state.data,products=Array.isArray(data.products)?data.products:[],userSlotNames=Array.isArray(data.userSlots)?data.userSlots:[];content.replaceChildren();if(!products.length){content.append(el("div","empty",data.message||"暂未查询到相关产品。"));return}const grid=el("section","grid");grid.tabIndex=0;grid.setAttribute("aria-label","推荐产品，左右滑动浏览");grid.addEventListener("keydown",event=>{if(event.key!=="ArrowLeft"&&event.key!=="ArrowRight")return;event.preventDefault();grid.scrollBy({left:(event.key==="ArrowRight"?1:-1)*grid.clientWidth*.82,behavior:"smooth"})});for(const product of products){card=el("article","product"),visual=el("div","visual"),imageUrl=safeUrl(product.imageUrl);if(imageUrl){visual.classList.add("has-image");const image=el("img");image.src=imageUrl;image.alt=product.name?`${product.name} 产品图`:"产品图";image.loading="lazy";image.referrerPolicy="no-referrer";image.addEventListener("error",()=>{image.remove();visual.classList.remove("has-image");visual.append(el("div","fallback","Haier"))},{once:true});visual.append(image)}else visual.append(el("div","fallback","Haier"));card.append(visual);const body=el("div","body");body.append(el("h2","product-title",displayTitle(product)),el("p","model",displaySeries(product)));const tags=orderedAttributes(product,userSlotNames).filter(attr=>!["价格","套系"].includes(text(attr.name))).slice(0,4).map(attr=>`${attr.name} · ${attr.value}`);for(const highlight of (product.highlights||[]).slice(0,Math.max(0,4-tags.length)))tags.push(highlight);if(tags.length){const attrs=el("div","attrs");for(const tag of tags)attrs.append(el("span","attr",tag));body.append(attrs)}else body.append(el("p","desc","商品参数以实际页面为准"));const footer=el("div","footer"),price=el("p",product.price===null||product.price===undefined||product.price===""?"price muted":"price",formatPrice(product.price));footer.append(price,el("p","source","海尔提供"));body.append(footer);card.append(body);grid.append(card)}content.append(grid)}
    function applyResult(result){const data=normalizeResult(result);if(data.phase==="error"){state.error=data.message||"结果暂时无法展示。";render();return}if(data.view&&data.view!=="recommend")return;if(["ready","empty"].includes(data.phase)){state.data=data;state.error="";render()}}
    const host=window.haierMcp;if(!host){state.error="页面桥接未就绪。";render();return}host.onToolResult(applyResult);host.onHostContextChanged(applyContext);Promise.resolve(host.ready).then(()=>{applyContext(host.getHostContext()||{});if(typeof host.applyPreviewResult==="function")host.applyPreviewResult({phase:"ready",view:"recommend",userSlots:["容量偏好"],total:3,products:[{rank:1,brand:"卡萨帝",prodCate:"冰箱",spectrum:"星云",name:"BCD-551WGHTD1CLJU1",price:"4000-6000",imageUrl:null,productUrl:null,attributes:[{name:"能效等级",value:"1级"},{name:"安装方式",value:"嵌入式"},{name:"容量偏好",value:"551"},{name:"套系",value:"星云"}],highlights:[],reasons:[]},{rank:2,brand:"海尔",prodCate:"冰箱",spectrum:"麦浪",name:"BCD-507WGHTD1BWLU1",price:"6000-8000",imageUrl:null,productUrl:null,attributes:[{name:"容量偏好",value:"507"},{name:"定频/变频",value:"变频"},{name:"安装方式",value:"嵌入式"},{name:"套系",value:"麦浪"}],highlights:[],reasons:[]},{rank:3,brand:"Leader",prodCate:"冰箱",spectrum:"",name:"BCD-575WGHMD1BYUU1",price:"8000-10000",imageUrl:null,productUrl:null,attributes:[{name:"容量偏好",value:"575"},{name:"颜色",value:"灰色"},{name:"能效等级",value:"1级"}],highlights:["大容量"],reasons:[]}]})});
  })();
  </script>
</body></html>
