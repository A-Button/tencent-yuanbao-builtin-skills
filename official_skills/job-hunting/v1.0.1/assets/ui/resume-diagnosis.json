{
  "components": [
    {
      "id": "root",
      "component": "Card",
      "child": "body",
      "style": {
        "padding": {
          "horizontal": 16,
          "vertical": 14
        },
        "containerColor": "basic_container_primary",
        "shape": 24
      }
    },
    {
      "id": "body",
      "component": "Column",
      "children": [
        "header-block",
        "tile-stack",
        "strengths-visible",
        "improvements-visible",
        "action-row"
      ],
      "align": "stretch",
      "style": {
        "spacing": 0
      }
    },
    {
      "id": "tile-stack",
      "component": "Column",
      "children": [
        "score-card",
        "profile-card"
      ],
      "align": "stretch",
      "style": {
        "spacing": 6
      }
    },
    {
      "id": "header-block",
      "component": "Column",
      "children": [
        "source-row",
        "title"
      ],
      "align": "stretch",
      "style": {
        "spacing": 6,
        "padding": {
          "bottom": 10
        }
      }
    },
    {
      "id": "source-row",
      "component": "Row",
      "children": [
        "source-icon",
        "source-label"
      ],
      "align": "center",
      "style": {
        "spacing": 4
      }
    },
    {
      "id": "source-icon",
      "component": "Text",
      "text": "✓",
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_blue",
        "fontWeight": 600
      }
    },
    {
      "id": "source-label",
      "component": "Text",
      "text": {
        "path": "/source_label"
      },
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_blue",
        "fontWeight": 600
      }
    },
    {
      "id": "title",
      "component": "Text",
      "text": {
        "path": "/title"
      },
      "variant": "h3",
      "maxLines": 2,
      "style": {
        "fontWeight": 600
      }
    },
    {
      "id": "score-card",
      "component": "Card",
      "child": "score-block",
      "style": {
        "padding": {
          "horizontal": 12,
          "vertical": 12
        },
        "containerColor": "basic_bg_secondary",
        "shape": 14
      }
    },
    {
      "id": "score-block",
      "component": "Column",
      "children": [
        "score-value",
        "score-label",
        "minor-stats"
      ],
      "align": "center",
      "style": {
        "spacing": 2
      }
    },
    {
      "id": "score-value",
      "component": "Text",
      "text": {
        "path": "/score"
      },
      "variant": "h2",
      "maxLines": 1,
      "style": {
        "fontWeight": 600
      }
    },
    {
      "id": "score-label",
      "component": "Text",
      "text": "综合评分",
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_text_quinary"
      }
    },
    {
      "id": "minor-stats",
      "component": "Row",
      "children": [
        "strength-block",
        "improvement-block"
      ],
      "justify": "center",
      "align": "center",
      "style": {
        "spacing": 14,
        "padding": {
          "top": 4
        }
      }
    },
    {
      "id": "strength-block",
      "component": "Row",
      "children": [
        "strength-value",
        "strength-label"
      ],
      "align": "center",
      "style": {
        "spacing": 4
      }
    },
    {
      "id": "strength-value",
      "component": "Text",
      "text": {
        "path": "/strengths_count"
      },
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_green",
        "fontWeight": 600
      }
    },
    {
      "id": "strength-label",
      "component": "Text",
      "text": "亮点",
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_text_quinary"
      }
    },
    {
      "id": "improvement-block",
      "component": "Row",
      "children": [
        "improvement-value",
        "improvement-label"
      ],
      "align": "center",
      "style": {
        "spacing": 4
      }
    },
    {
      "id": "improvement-value",
      "component": "Text",
      "text": {
        "path": "/improvements_count"
      },
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_orange",
        "fontWeight": 600
      }
    },
    {
      "id": "improvement-label",
      "component": "Text",
      "text": "待改进",
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_text_quinary"
      }
    },
    {
      "id": "profile-card",
      "component": "Card",
      "child": "profile-body",
      "style": {
        "padding": {
          "horizontal": 12,
          "vertical": 10
        },
        "containerColor": "basic_bg_secondary",
        "shape": 14
      }
    },
    {
      "id": "profile-body",
      "component": "Column",
      "children": [
        "profile-row",
        "profile-summary"
      ],
      "align": "stretch",
      "style": {
        "spacing": 4
      }
    },
    {
      "id": "profile-row",
      "component": "Row",
      "children": [
        "role",
        "task-status"
      ],
      "justify": "spaceBetween",
      "align": "center",
      "style": {
        "spacing": 8
      }
    },
    {
      "id": "role",
      "component": "Text",
      "text": {
        "path": "/role"
      },
      "variant": "h5",
      "maxLines": 1,
      "weight": 1,
      "style": {
        "fontWeight": 600
      }
    },
    {
      "id": "task-status",
      "component": "Text",
      "text": {
        "path": "/task_status"
      },
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_blue",
        "fontWeight": 600
      }
    },
    {
      "id": "profile-summary",
      "component": "Text",
      "text": {
        "path": "/profile_summary"
      },
      "variant": "caption",
      "maxLines": 2,
      "style": {
        "color": "basic_text_quinary"
      }
    },
    {
      "id": "strengths-visible",
      "component": "Visibility",
      "value": {
        "path": "/has_strengths"
      },
      "child": "strengths-section"
    },
    {
      "id": "strengths-section",
      "component": "Column",
      "children": [
        "strengths-header",
        "strengths-list"
      ],
      "align": "stretch"
    },
    {
      "id": "strengths-header",
      "component": "Text",
      "text": "亮点",
      "variant": "h4",
      "maxLines": 1,
      "style": {
        "fontWeight": 600,
        "padding": {
          "top": 12
        }
      }
    },
    {
      "id": "strengths-list",
      "component": "Column",
      "align": "stretch",
      "children": {
        "path": "/strengths",
        "componentId": "strength-item"
      },
      "style": {
        "spacing": 6,
        "padding": {
          "top": 6
        }
      }
    },
    {
      "id": "strength-item",
      "component": "Card",
      "child": "strength-body",
      "style": {
        "padding": {
          "horizontal": 12,
          "vertical": 10
        },
        "containerColor": "basic_bg_secondary",
        "shape": 14
      }
    },
    {
      "id": "strength-body",
      "component": "Column",
      "children": [
        "strength-heading",
        "strength-detail"
      ],
      "align": "stretch",
      "style": {
        "spacing": 4
      }
    },
    {
      "id": "strength-heading",
      "component": "Row",
      "children": [
        "strength-mark",
        "strength-title"
      ],
      "align": "center",
      "style": {
        "spacing": 6
      }
    },
    {
      "id": "strength-mark",
      "component": "Text",
      "text": "✓",
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_green",
        "fontWeight": 600
      }
    },
    {
      "id": "strength-title",
      "component": "Text",
      "text": {
        "path": "title"
      },
      "variant": "h5",
      "maxLines": 2,
      "weight": 1,
      "style": {
        "fontWeight": 600
      }
    },
    {
      "id": "strength-detail",
      "component": "Text",
      "text": {
        "path": "detail"
      },
      "variant": "caption",
      "maxLines": 2,
      "style": {
        "color": "basic_text_quinary"
      }
    },
    {
      "id": "improvements-visible",
      "component": "Visibility",
      "value": {
        "path": "/has_improvements"
      },
      "child": "improvements-section"
    },
    {
      "id": "improvements-section",
      "component": "Column",
      "children": [
        "improvements-header",
        "improvements-list"
      ],
      "align": "stretch"
    },
    {
      "id": "improvements-header",
      "component": "Text",
      "text": "待改进",
      "variant": "h4",
      "maxLines": 1,
      "style": {
        "fontWeight": 600,
        "padding": {
          "top": 12
        }
      }
    },
    {
      "id": "improvements-list",
      "component": "Column",
      "align": "stretch",
      "children": {
        "path": "/improvements",
        "componentId": "improvement-item"
      },
      "style": {
        "spacing": 6,
        "padding": {
          "top": 6
        }
      }
    },
    {
      "id": "improvement-item",
      "component": "Card",
      "child": "improvement-body",
      "style": {
        "padding": {
          "horizontal": 12,
          "vertical": 10
        },
        "containerColor": "basic_bg_secondary",
        "shape": 14
      }
    },
    {
      "id": "improvement-body",
      "component": "Column",
      "children": [
        "improvement-heading",
        "improvement-detail"
      ],
      "align": "stretch",
      "style": {
        "spacing": 4
      }
    },
    {
      "id": "improvement-heading",
      "component": "Row",
      "children": [
        "improvement-mark",
        "improvement-title"
      ],
      "align": "center",
      "style": {
        "spacing": 6
      }
    },
    {
      "id": "improvement-mark",
      "component": "Text",
      "text": "!",
      "variant": "caption",
      "maxLines": 1,
      "style": {
        "color": "basic_function_orange",
        "fontWeight": 600
      }
    },
    {
      "id": "improvement-title",
      "component": "Text",
      "text": {
        "path": "title"
      },
      "variant": "h5",
      "maxLines": 2,
      "weight": 1,
      "style": {
        "fontWeight": 600
      }
    },
    {
      "id": "improvement-detail",
      "component": "Text",
      "text": {
        "path": "detail"
      },
      "variant": "caption",
      "maxLines": 2,
      "style": {
        "color": "basic_text_quinary"
      }
    },
    {
      "id": "action-row",
      "component": "Row",
      "children": [
        "view-button",
        "rewrite-button"
      ],
      "justify": "end",
      "align": "center",
      "style": {
        "spacing": 4,
        "padding": {
          "top": 12
        }
      }
    },
    {
      "id": "view-button",
      "component": "Button",
      "child": "view-label",
      "variant": "default",
      "style": {
        "containerColor": "components_button_gray",
        "shape": 18
      },
      "action": {
        "functionCall": {
          "call": "sendQuery",
          "args": {
            "prompt": "请展示我当前简历的完整诊断，逐条列出亮点、待改进项和具体修改建议。"
          }
        }
      }
    },
    {
      "id": "view-label",
      "component": "Text",
      "text": "查看完整诊断",
      "maxLines": 1,
      "style": {
        "color": "basic_text_primary"
      }
    },
    {
      "id": "rewrite-button",
      "component": "Button",
      "child": "rewrite-label",
      "variant": "primary",
      "style": {
        "containerColor": "components_button_primary",
        "shape": 18
      },
      "action": {
        "functionCall": {
          "call": "sendQuery",
          "args": {
            "prompt": "请根据当前简历的诊断结果帮我改写一版简历，保存为新版本并展示改写后的简历诊断卡。"
          }
        }
      }
    },
    {
      "id": "rewrite-label",
      "component": "Text",
      "text": "帮我改一版",
      "maxLines": 1,
      "style": {
        "color": "components_button_primary_title"
      }
    }
  ]
}
