{
  "tools": [
    {
      "name": "confirmCancelHotelBooking",
      "description": "使用 preCancelHotelBooking 返回的 confirmId 和 bookingId 确认并执行酒店订单的最终取消。此操作不可撤销，调用前必须获得用户的明确确认。",
      "inputSchema": {
        "properties": {
          "bookingId": {
            "description": "preCancelHotelBooking 返回的预订号（bookingId）",
            "type": "string"
          },
          "confirmId": {
            "description": "preCancelHotelBooking 返回的取消确认凭证（confirmId），有效期 10 分钟",
            "type": "string"
          },
          "description": {
            "description": "可选的取消原因或备注",
            "type": "string"
          },
          "orderNo": {
            "description": "preCancelHotelBooking 返回的订单号",
            "type": "string"
          }
        },
        "required": [
          "bookingId",
          "confirmId",
          "orderNo"
        ],
        "type": "object"
      }
    },
    {
      "name": "createHotelBookingWithPaymentURL",
      "description": "创建酒店订单并返回 Dida 前端支付页 URL，不直接返回支付宝或微信支付方链接。支付页会解析 token，由前端根据 PC/H5/微信/小程序环境选择支付方式，并调用酒店 repay 接口创建真实支付意图。",
      "inputSchema": {
        "properties": {
          "alipayUid": {
            "description": "支付宝 UID（千问 getAlipayUid 返回，Agent AI 付可选）",
            "type": "string"
          },
          "contact": {
            "description": "联系人信息",
            "properties": {
              "email": {
                "description": "联系邮箱",
                "type": "string"
              },
              "firstName": {
                "description": "名",
                "type": "string"
              },
              "lastName": {
                "description": "姓",
                "type": "string"
              }
            },
            "required": [
              "email",
              "firstName",
              "lastName"
            ],
            "type": "object"
          },
          "customerRequest": {
            "description": "客户特殊要求",
            "type": "string"
          },
          "guestList": {
            "description": "客人信息列表。必须与已确认的房间数一一对应，并且每间房至少包含一名成人客人。",
            "items": {
              "properties": {
                "guestInfo": {
                  "description": "该房间的客人列表。每间房必须至少包含一名 isAdult=true 的成人客人。",
                  "items": {
                    "properties": {
                      "age": {
                        "description": "年龄(儿童必填)",
                        "format": "int32",
                        "type": "integer"
                      },
                      "firstName": {
                        "description": "名(拼音或英文)",
                        "type": "string"
                      },
                      "isAdult": {
                        "description": "是否成人，必填；true 表示成人，false 表示儿童。每间房至少需要一名成人。",
                        "type": "boolean"
                      },
                      "lastName": {
                        "description": "姓(拼音或英文)",
                        "type": "string"
                      }
                    },
                    "required": [
                      "firstName",
                      "isAdult",
                      "lastName"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "roomNum": {
                  "description": "房间序号,从 1 开始",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "guestInfo",
                "roomNum"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "referenceNo": {
            "description": "预订参考号",
            "type": "string"
          }
        },
        "required": [
          "contact",
          "guestList",
          "referenceNo"
        ],
        "type": "object"
      }
    },
    {
      "name": "getHotelDetail",
      "description": "查询单个酒店实时房型与价格明细（房型、价税、可售状态、退改规则等）。用于用户已选定具体酒店后的二次查价",
      "inputSchema": {
        "properties": {
          "dateParam": {
            "description": "入离店日期对象",
            "properties": {
              "checkInDate": {
                "description": "入住日期，格式 YYYY-MM-DD。建议传合法未来日期",
                "type": "string"
              },
              "checkOutDate": {
                "description": "离店日期，格式 YYYY-MM-DD，必须晚于 checkInDate",
                "type": "string"
              }
            },
            "type": "object"
          },
          "filter": {
            "description": "房型筛选条件对象。未传或为空时返回全部房型；多条件 AND 组合。",
            "properties": {
              "cancelPolicy": {
                "description": "取消政策筛选。CANCELABLE：仅可免费取消房型；NON_CANCELABLE：仅不可取消房型。非法值忽略。",
                "enum": [
                  "CANCELABLE",
                  "NON_CANCELABLE"
                ],
                "type": "string"
              },
              "mealType": {
                "description": "餐食类别枚举。WITH_BREAKFAST（含早餐，mealAmount>0）/ SINGLE_BREAKFAST（单份早餐，mealAmount=1）/ DOUBLE_BREAKFAST（双份早餐，mealAmount=2）/ NO_MEAL（不含餐食，mealAmount=0）。非法值忽略。",
                "enum": [
                  "WITH_BREAKFAST",
                  "SINGLE_BREAKFAST",
                  "DOUBLE_BREAKFAST",
                  "NO_MEAL"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "hotelId": {
            "description": "酒店唯一ID。与 name 二选一；若同时传入，优先使用 hotelId（从searchHotels工具获取）",
            "format": "int32",
            "type": "integer"
          },
          "name": {
            "description": "酒店名称（模糊匹配）。仅在没有 hotelId 时使用",
            "type": "string"
          },
          "occupancyParam": {
            "description": "入住人数与房间数量对象",
            "properties": {
              "adultCount": {
                "description": "每间房成人数，整数，>=1，默认2",
                "format": "int32",
                "type": "integer"
              },
              "childAgeDetails": {
                "description": "儿童年龄数组，如 [3,5]；长度应与 childCount 一致",
                "items": {
                  "format": "int32",
                  "type": "integer"
                },
                "type": "array"
              },
              "childCount": {
                "description": "每间房儿童数，整数，>=0，默认0",
                "format": "int32",
                "type": "integer"
              },
              "roomCount": {
                "description": "房间数，整数，>=1，默认1",
                "format": "int32",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "getHotelOrderDetail",
      "description": "根据订单号查询单个酒店订单的完整详情，包括酒店信息、入住信息、价格、客人姓名及取消政策。在 searchHotelOrders 之后使用此工具获取具体订单的详细信息。",
      "inputSchema": {
        "properties": {
          "orderNo": {
            "description": "订单号，唯一标识一个酒店订单",
            "type": "string"
          }
        },
        "required": [
          "orderNo"
        ],
        "type": "object"
      }
    },
    {
      "name": "getHotelSearchTags",
      "description": "获取酒店搜索元数据（AI Cache），包含可用的标签列表（以当前启用数据为准）。",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "hotelPriceConfirm",
      "description": "确认酒店房型价格并获取 referenceNo。用于在选定具体房型后、创建订单前进行价格确认。需要提供酒店ID、价格方案ID、入离店日期、房间数量等信息。返回价格详情和 referenceNo，用于后续调用 createHotelBookingWithAlipayUrl 创建订单。",
      "inputSchema": {
        "properties": {
          "dateParam": {
            "description": "入离店日期对象",
            "properties": {
              "checkInDate": {
                "description": "入住日期,格式 YYYY-MM-DD",
                "type": "string"
              },
              "checkOutDate": {
                "description": "离店日期,格式 YYYY-MM-DD,必须晚于 checkInDate",
                "type": "string"
              }
            },
            "required": [
              "checkInDate",
              "checkOutDate"
            ],
            "type": "object"
          },
          "hotelID": {
            "description": "酒店ID",
            "format": "int32",
            "type": "integer"
          },
          "numOfRooms": {
            "description": "房间数量,整数,>=1",
            "format": "int32",
            "type": "integer"
          },
          "occupancyDetails": {
            "description": "入住人数与房间数量对象",
            "items": {
              "properties": {
                "adultCount": {
                  "description": "每间房成人数,整数,>=1,默认2",
                  "format": "int32",
                  "type": "integer"
                },
                "childAgeDetails": {
                  "description": "儿童年龄数组,如 [3,5];长度应与 childCount 一致",
                  "items": {
                    "format": "int32",
                    "type": "integer"
                  },
                  "type": "array"
                },
                "childCount": {
                  "description": "每间房儿童数,整数,>=0,默认0",
                  "format": "int32",
                  "type": "integer"
                },
                "roomNum": {
                  "description": "房间数,整数,>=1,默认1",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "adultCount",
                "roomNum"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "ratePlanID": {
            "description": "价格方案ID",
            "type": "string"
          }
        },
        "required": [
          "dateParam",
          "hotelID",
          "numOfRooms",
          "occupancyDetails",
          "ratePlanID"
        ],
        "type": "object"
      }
    },
    {
      "name": "preCancelHotelBooking",
      "description": "预取消酒店订单，查询取消罚金并获取 10 分钟有效的 confirmId。实际取消前必须先调用本工具，再调用 confirmCancelHotelBooking 完成取消。",
      "inputSchema": {
        "properties": {
          "orderNo": {
            "description": "订单号，唯一标识一个酒店订单",
            "type": "string"
          }
        },
        "required": [
          "orderNo"
        ],
        "type": "object"
      }
    },
    {
      "name": "searchHotelOrders",
      "description": "查询当前用户的酒店订单列表，返回每笔订单的详细信息，包括酒店名称、入住/离店日期、房型、价格及订单状态。",
      "inputSchema": {
        "properties": {
          "dateRange": {
            "description": "下单日期范围（按 orderDate 过滤）",
            "properties": {
              "endDate": {
                "description": "结束日期，格式 YYYY-MM-DD，含当天",
                "type": "string"
              },
              "startDate": {
                "description": "开始日期，格式 YYYY-MM-DD，含当天",
                "type": "string"
              }
            },
            "required": [
              "endDate",
              "startDate"
            ],
            "type": "object"
          },
          "status": {
            "description": "订单状态过滤：ALL / PENDING / FINISHED，不传默认 ALL",
            "type": "string"
          }
        },
        "required": [
          "dateRange",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "name": "searchHotels",
      "description": "该工具用于查询全球酒店。根据地点及结构化筛选条件（日期、入住晚数、人数、星级、距离、标签、品牌、预算）返回符合条件的酒店候选列表与最低价格，用于酒店初筛与比选。",
      "inputSchema": {
        "properties": {
          "checkInParam": {
            "description": "入住信息参数，包括入住日期、入住天数和每间房成人数量",
            "properties": {
              "adultCount": {
                "description": "每间房入住的成人数量，默认两成人",
                "format": "int32",
                "type": "integer"
              },
              "checkInDate": {
                "description": "入住日期，格式：YYYY-MM-DD，例如：2026-02-01。可不传；未传或早于今天时，自动使用明天；格式错误会返回参数错误",
                "type": "string"
              },
              "stayNights": {
                "description": "入住天数（晚数），可不传，默认 1 晚。最多 28 晚，超出限制将返回参数错误。",
                "format": "int32",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "filterOptions": {
            "description": "酒店筛选选项，例如酒店星级、每间房成人数、距离等",
            "properties": {
              "distanceInMeter": {
                "description": "直线距离，单位（米），当地点是一个POI位置时生效，生效时默认设定值为2000",
                "format": "int32",
                "type": "integer"
              },
              "starRatings": {
                "description": "酒店星级(0.0-5.0, 梯度为0.5)，默认[0.0, 5.0]以上，例如 [4.5, 5.0]，[0.0, 2.0]",
                "items": {
                  "format": "double",
                  "type": "number"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "hotelTags": {
            "description": "酒店筛选标签参数（可选）。当传入此参数时，将直接使用这些标签进行筛选和排序，无需服务端额外解析。包含字段：requiredTags（必须标签）、preferredBrands（偏好品牌）、maxPricePerNight（每晚最高预算）",
            "properties": {
              "maxPricePerNight": {
                "description": "每晚价格上限（人民币，数值）",
                "format": "double",
                "type": "number"
              },
              "preferredBrands": {
                "description": "偏好品牌",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "requiredTags": {
                "description": "必须命中标签（硬约束，未命中应被过滤）",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "originQuery": {
            "description": "综合多轮对话，归纳用户的完整住宿/预订意图。",
            "type": "string"
          },
          "place": {
            "description": "搜索地点关键词/酒店名称。具体酒店直接填入酒店名称；位置或区县需用空格补齐城市，填入 位置 城市；仅查询城市需补齐国家，填入 城市 国家。",
            "type": "string"
          },
          "placeType": {
            "description": "place 的类型，必须与 place 的实际内容一致。可选值：城市、机场、景点、火车站、地铁站、酒店、区/县、详细地址。",
            "type": "string"
          },
          "size": {
            "description": "返回酒店结果数量，默认5个酒店，最大不超过20个",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "originQuery",
          "place",
          "placeType"
        ],
        "type": "object"
      }
    }
  ]
}