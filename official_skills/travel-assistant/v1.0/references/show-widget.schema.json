                    "pattern": "^https://"
                  },
                  "selected": {
                    "type": "boolean"
                  },
                  "done": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "option_id",
                  "title"
                ],
                "not": {
                  "properties": {
                    "selected": {
                      "const": true
                    },
                    "done": {
                      "const": true
                    }
                  },
                  "required": [
                    "selected",
                    "done"
                  ]
                }
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "select_mode",
            "options"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "select_mode": {
                    "const": 1
                  }
                },
                "required": [
                  "select_mode"
                ]
              },
              "then": {
                "properties": {
                  "options": {
                    "contains": {
                      "properties": {
                        "selected": {
                          "const": true
                        }
                      },
                      "required": [
                        "selected"
                      ]
                    },
                    "minContains": 0,
                    "maxContains": 1
                  }
                }
              }
            }
          ]
        }
